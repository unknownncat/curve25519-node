{
  "name": "curve25519-node-bench",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "Benchmarks for @unknownncat/curve25519-node vs curve25519-js",
  "scripts": {
    "compat:axlsign": "node axlsign-compat-check.mjs --iterations=512",
    "bench": "node --expose-gc bench.mjs --variants=raw",
    "bench:quick": "node --expose-gc bench.mjs --rounds=8 --roundMs=180 --warmupMs=200 --variants=raw",
    "bench:full": "node --expose-gc bench.mjs --rounds=16 --roundMs=350 --warmupMs=500 --variants=raw,cached,nocopy,copy --verifyDuringBench --verifyEvery=64",
    "bench:strict": "node --expose-gc bench.mjs --rounds=12 --roundMs=250 --warmupMs=300 --variants=raw,cached --strict",
    "bench:ci": "node --expose-gc bench.mjs --rounds=16 --roundMs=350 --warmupMs=500 --vectors=64 --variants=raw,cached --strict --verifyEvery=64 --jsonFile=results/bench-results.json",
    "bench:regression": "node --expose-gc bench.mjs --variants=raw,cached --strict --baseline=results/bench-baseline.json --failOnRegression --maxRegressionPct=10",
    "prepublishOnly": "node -e \"console.error('bench/ is private and should not be published. Publish from repository root package instead.'); process.exit(1)\""
  },
  "dependencies": {
    "@unknownncat/curve25519-node": "file:..",
    "curve25519-js": "^0.0.4"
  },
  "engines": {
    "node": ">=20"
  }
}
