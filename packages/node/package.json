{
  "name": "@unknownncat/curve25519-node",
  "version": "2.1.1",
  "description": "Node.js X25519 + Ed25519 via node:crypto with axlsign compatibility in pure Node runtime",
  "keywords": [
    "curve25519",
    "x25519",
    "ed25519",
    "axlsign",
    "crypto",
    "cryptography",
    "openssl",
    "node"
  ],
  "homepage": "https://github.com/unknownncat/curve25519-node#readme",
  "bugs": {
    "url": "https://github.com/unknownncat/curve25519-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unknownncat/curve25519-node.git"
  },
  "license": "MIT",
  "author": "unknownncat",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    },
    "./x25519": {
      "types": "./dist/x25519.d.ts",
      "import": "./dist/x25519.js",
      "require": "./dist/cjs/x25519.js",
      "default": "./dist/x25519.js"
    },
    "./ed25519": {
      "types": "./dist/ed25519.d.ts",
      "import": "./dist/ed25519.js",
      "require": "./dist/cjs/ed25519.js",
      "default": "./dist/ed25519.js"
    },
    "./axlsign": {
      "types": "./dist/axlsign.d.ts",
      "import": "./dist/axlsign.js",
      "require": "./dist/cjs/axlsign.js",
      "default": "./dist/axlsign.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/cjs/types.js",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "README.en.md",
    "NOTICE.md",
    "THIRD_PARTY_NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-cjs-package-json.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:cross": "npm run build && npm --prefix ../browser run build && node --test \"test/cross-runtime.cross.mjs\"",
    "audit": "npm audit",
    "audit:prod": "npm audit --omit=dev",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "release:check": "npm run ci && npm pack --dry-run --ignore-scripts",
    "bench": "npm run build && npm --prefix ../../bench run bench",
    "bench:quick": "npm run build && npm --prefix ../../bench run bench:quick",
    "prepack": "npm run ci",
    "prepublishOnly": "npm run ci"
  }
}
