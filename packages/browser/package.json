{
  "name": "@unknownncat/curve25519-browser",
  "version": "2.1.1",
  "description": "WASM-first X25519 + Ed25519 + axlsign for browsers",
  "keywords": [
    "curve25519",
    "x25519",
    "ed25519",
    "axlsign",
    "wasm",
    "browser",
    "crypto",
    "cryptography"
  ],
  "homepage": "https://github.com/unknownncat/curve25519-node#readme",
  "bugs": {
    "url": "https://github.com/unknownncat/curve25519-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unknownncat/curve25519-node.git"
  },
  "license": "MIT",
  "author": "unknownncat",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./x25519": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js",
      "default": "./dist/wasm.js"
    },
    "./ed25519": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js",
      "default": "./dist/wasm.js"
    },
    "./axlsign": {
      "types": "./dist/axlsign.d.ts",
      "import": "./dist/axlsign.js",
      "default": "./dist/axlsign.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js",
      "default": "./dist/wasm.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:deps": "npm --prefix ../core run build",
    "clean": "node scripts/clean.mjs",
    "build:wasm": "node scripts/build-axlsign-wasm.mjs && node scripts/build-curve25519-wasm.mjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:copy-wasm": "node scripts/copy-wasm.mjs",
    "build": "npm run build:deps && npm run clean && npm run build:wasm && npm run build:esm && npm run build:copy-wasm",
    "typecheck": "npm run build:deps && npm run build:wasm && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "prepack": "npm run ci",
    "prepublishOnly": "npm run ci"
  },
  "dependencies": {
    "@unknownncat/curve25519-core": "2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.1"
  }
}
