{
  "name": "@unknownncat/curve25519-node",
  "version": "1.0.1",
  "description": "Zero-dependency Curve25519 toolkit for Node.js: native X25519/Ed25519 (node:crypto/OpenSSL) + legacy axlsign compatibility via Rust/WASM",
  "keywords": [
    "curve25519",
    "x25519",
    "ed25519",
    "axlsign",
    "wasm",
    "crypto",
    "cryptography",
    "openssl",
    "node"
  ],
  "homepage": "https://github.com/unknownncat/curve25519-node#readme",
  "bugs": {
    "url": "https://github.com/unknownncat/curve25519-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unknownncat/curve25519-node.git"
  },
  "license": "MIT",
  "author": "unknownncat",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    },
    "./x25519": {
      "types": "./dist/x25519.d.ts",
      "import": "./dist/x25519.js",
      "require": "./dist/cjs/x25519.js",
      "default": "./dist/x25519.js"
    },
    "./ed25519": {
      "types": "./dist/ed25519.d.ts",
      "import": "./dist/ed25519.js",
      "require": "./dist/cjs/ed25519.js",
      "default": "./dist/ed25519.js"
    },
    "./axlsign": {
      "types": "./dist/axlsign.d.ts",
      "import": "./dist/axlsign.js",
      "require": "./dist/cjs/axlsign.js",
      "default": "./dist/axlsign.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/cjs/types.js",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:wasm": "node scripts/build-axlsign-wasm.mjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-cjs-package-json.mjs",
    "build:copy-wasm": "node scripts/copy-axlsign-wasm.mjs",
    "build": "npm run clean && npm run build:wasm && npm run build:esm && npm run build:cjs && npm run build:copy-wasm",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "bench": "npm run build && npm --prefix bench run bench",
    "bench:quick": "npm run build && npm --prefix bench run bench:quick",
    "prepack": "npm run test",
    "prepublishOnly": "npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "typescript": "^5.9.2"
  }
}
